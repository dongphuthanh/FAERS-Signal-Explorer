{
  "name": "faers-signal-explorer",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v",
    "db:psql": "docker compose exec db psql -U postgres -d faers",
    "migrate": "node --env-file=.env scripts/migrate.mjs",
    "load:faers": "node --env-file=.env scripts/load-faers.mjs",
    "derive": "node --env-file=.env scripts/derive.mjs",
    "test": "node --env-file=.env --test --test-concurrency=1",
    "drugs:load": "node --env-file=.env scripts/load-drugs.mjs",
    "labels:fetch": "node --env-file=.env scripts/fetch-dailymed.mjs",
    "labels:ingest": "node --env-file=.env scripts/ingest-dailymed.mjs",
    "labels:embed": "node --env-file=.env scripts/embed-labels.mjs",
    "search": "node --env-file=.env scripts/search.mjs",
    "eval:retrieval": "node --env-file=.env scripts/eval-retrieval.mjs",
    "terms:load": "node --env-file=.env scripts/load-exclusions.mjs",
    "diff": "node --env-file=.env scripts/diff.mjs",
    "ask": "node --env-file=.env scripts/ask.mjs",
    "serve": "node --env-file=.env src/server.mjs",
    "serve:stub": "node --env-file=.env -e \"process.env.STUB=1; import('./src/server.mjs')\"",
    "eval:agent": "node --env-file=.env scripts/eval-agent.mjs",
    "serve:public": "node --env-file=.env scripts/serve-public.mjs",
    "sessions": "node scripts/sessions.mjs",
    "drugs:salts": "node --env-file=.env scripts/group-salts.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@fastify/static": "^10.1.3",
    "@xenova/transformers": "^2.17.2",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.4",
    "pg": "^8.13.0"
  }
}
