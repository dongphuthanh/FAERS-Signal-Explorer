# copy to .env and adjust. read by both docker compose and `node --env-file=.env`.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=faers
POSTGRES_DB=faers
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:faers@localhost:5432/faers

# phase 4 — the agent. claude-opus-5 is the default; claude-haiku-4-5 is the cheap option.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# serve:public — required before opening a tunnel; any username, this password.
DEMO_PASSWORD=
# questions per UTC day before the server says "closed until tomorrow" (default 60)
DEMO_DAILY_CAP=60
